<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BackgroundColor">#F5F7FB</Color>
            <Color x:Key="HeaderBackgroundColor">#FAFBFE</Color>
            <Color x:Key="CardColor">#FFFFFFFF</Color>
            <Color x:Key="SurfaceColor">#EEF3F8</Color>
            <Color x:Key="InputColor">#FFFFFFFF</Color>
            <Color x:Key="InputFocusColor">#F8FBFF</Color>
            <Color x:Key="TextPrimaryColor">#111827</Color>
            <Color x:Key="TextSecondaryColor">#64748B</Color>
            <Color x:Key="AccentColor">#2563EB</Color>
            <Color x:Key="AccentHoverColor">#1D4ED8</Color>
            <Color x:Key="AccentSoftColor">#E0ECFF</Color>
            <Color x:Key="AccentSofterColor">#D3E4FF</Color>
            <Color x:Key="AccentBorderColor">#93B7FF</Color>
            <Color x:Key="BorderColor">#DCE4EE</Color>
            <Color x:Key="ScrimColor">#F4F8FCDD</Color>
            <Color x:Key="ErrorColor">#B42318</Color>
            <Color x:Key="ErrorSoftColor">#FFF0F0</Color>
            <Color x:Key="SuccessColor">#16803A</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BackgroundColor">#10151E</Color>
            <Color x:Key="HeaderBackgroundColor">#151B25</Color>
            <Color x:Key="CardColor">#18202B</Color>
            <Color x:Key="SurfaceColor">#202A37</Color>
            <Color x:Key="InputColor">#111827</Color>
            <Color x:Key="InputFocusColor">#14213A</Color>
            <Color x:Key="TextPrimaryColor">#F4F7FB</Color>
            <Color x:Key="TextSecondaryColor">#AAB7C7</Color>
            <Color x:Key="AccentColor">#5EA1FF</Color>
            <Color x:Key="AccentHoverColor">#8CBDFF</Color>
            <Color x:Key="AccentSoftColor">#203B63</Color>
            <Color x:Key="AccentSofterColor">#294B79</Color>
            <Color x:Key="AccentBorderColor">#426EA5</Color>
            <Color x:Key="BorderColor">#2D3A4C</Color>
            <Color x:Key="ScrimColor">#111827E6</Color>
            <Color x:Key="ErrorColor">#FFB4AB</Color>
            <Color x:Key="ErrorSoftColor">#351C1D</Color>
            <Color x:Key="SuccessColor">#7DDC92</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{DynamicResource HeaderBackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{DynamicResource InputColor}" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="{DynamicResource InputFocusColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentSofterBrush" Color="{DynamicResource AccentSofterColor}" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{DynamicResource AccentBorderColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{DynamicResource ScrimColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{DynamicResource ErrorSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />

    <BoxShadows x:Key="SmallShadow">0 8 18 0 #120F172A</BoxShadows>
    <BoxShadows x:Key="MediumShadow">0 14 34 0 #180F172A</BoxShadows>
    <BoxShadows x:Key="LargeShadow">0 22 46 0 #220F172A</BoxShadows>
</ResourceDictionary>
